{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ECC V2 Project Identity",
  "type": "object",
  "required": ["schema_version", "id", "name", "project_type", "source", "harness_version"],
  "properties": {
    "schema_version": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "project_type": { "type": "string", "minLength": 1 },
    "target_platform": { "type": ["string", "null"] },
    "source": { "enum": ["new", "imported"] },
    "repo_url": { "type": ["string", "null"] },
    "locale": { "enum": ["zh-CN", "en-US"] },
    "harness_version": { "type": "string" }
  }
}
